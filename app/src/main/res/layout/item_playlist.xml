<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="120dp">

        <!-- Left Color Bar -->

        <View
            android:id="@+id/leftBar"
            android:layout_width="7dp"
            android:layout_height="match_parent"
            android:background="@color/primary"/>

        <!-- Number Card -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/imgThumbnail"
            android:layout_width="70dp"
            android:layout_height="80dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="18dp"
            android:layout_toEndOf="@id/leftBar"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E8F0FF">

            <TextView
                android:id="@+id/txtNumber"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="01"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/primary"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- Arrow Button -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/arrowCard"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="18dp"
            app:cardCornerRadius="21dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E8F0FF">

            <ImageView
                android:id="@+id/arrowIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:src="@android:drawable/ic_media_next"
                app:tint="@color/primary"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- Content -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/imgThumbnail"
            android:layout_toStartOf="@id/arrowCard"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <!-- Playlist Title -->

            <TextView
                android:id="@+id/txtPlaylistTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Java Complete Placement Playlist"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:layout_marginTop="2dp"
                android:maxLines="2"/>

            <!-- Teacher -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTeacher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Apna College"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="@color/textSecondary"/>

            <!-- Playlist Chip -->

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPlaylist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Playlist"
                android:layout_marginLeft="8dp"
                android:textSize="9sp"
                android:textColor="@color/primary"
                app:chipBackgroundColor="#E8F0FF"
                app:chipCornerRadius="12dp"
                app:chipStrokeWidth="0dp"
                app:chipIcon="@android:drawable/ic_media_play"
                app:chipIconTint="@color/black"/>

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>